pipeline {
  agent { label 'python-build-node' }

  tools {
    maven 'maven3.9.6'
  }

  environment {
    IMAGE_REPO   = "ndiforfusi/fusisoft-webapp"
    NOTIFY_EMAIL = "fusisoft@gmail.com"
    DOCKER_CREDS = "dockerhub-ndiforfusi"
  }

  parameters {
    string(
      name: 'IMAGE_TAG',
      defaultValue: '1.0.0',
      description: 'Docker image version tag (e.g. 1.0.0, 1.1.0)'
    )
    booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run tests?')
    booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Deploy container on this agent?')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      steps {
        script {
          def mvnHome = tool(name: 'maven3.9.6', type: 'hudson.tasks.Maven$MavenInstallation')
          sh """
            set -euo pipefail
            ${mvnHome}/bin/mvn -B -f pom.xml clean package -DskipTests
          """
        }
      }
    }

    stage('Test (optional)') {
      when { expression { params.RUN_TESTS } }
      steps {
        script {
          def mvnHome = tool(name: 'maven3.9.6', type: 'hudson.tasks.Maven$MavenInstallation')
          sh """
            set -euo pipefail
            ${mvnHome}/bin/mvn -B -f pom.xml test
          """
        }
      }
    }

    stage('Docker Login') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: "${DOCKER_CREDS}",
            usernameVariable: 'DH_USER',
            passwordVariable: 'DH_TOKEN'
          )
        ]) {
          sh '''
            set -euo pipefail
            echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
          '''
        }
      }
    }

    stage('Docker Build & Push') {
      steps {
        sh '''
          set -euo pipefail
          echo "Building Docker image with tag: ${IMAGE_TAG}"

          docker build \
            -t ${IMAGE_REPO}:${IMAGE_TAG} \
            -t ${IMAGE_REPO}:latest .

          docker push ${IMAGE_REPO}:${IMAGE_TAG}
          docker push ${IMAGE_REPO}:latest
        '''
      }
    }

    stage('Deploy (optional)') {
      when { expression { params.DEPLOY } }
      steps {
        sh '''
          set -euo pipefail
          echo "Deploying image: ${IMAGE_REPO}:${IMAGE_TAG}"

          docker stop fusisoft-webapp 2>/dev/null || true
          docker rm fusisoft-webapp 2>/dev/null || true

          docker pull ${IMAGE_REPO}:${IMAGE_TAG}
          docker run -d --restart unless-stopped \
            --name fusisoft-webapp \
            -p 8085:8080 \
            ${IMAGE_REPO}:${IMAGE_TAG}

          docker ps --filter "name=fusisoft-webapp"
        '''
      }
    }
  }

  post {
    success {
      mail to: "${env.NOTIFY_EMAIL}",
           subject: "✅ Jenkins SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
           body: """\
Status: SUCCESS ✅
Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Docker Image: ${env.IMAGE_REPO}:${params.IMAGE_TAG}
Build URL: ${env.BUILD_URL}
"""
    }

    failure {
      mail to: "${env.NOTIFY_EMAIL}",
           subject: "❌ Jenkins FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
           body: """\
Status: FAILED ❌
Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Docker Image: ${env.IMAGE_REPO}:${params.IMAGE_TAG}
Console: ${env.BUILD_URL}console
"""
    }

    always {
      sh 'docker logout >/dev/null 2>&1 || true'
      cleanWs()
    }
  }
}

