//envieonmental variable = jenkins url env-vars.html
CODE_CHANGES = getGitChanges()
pipeline {
agent any
parameters {
  string(name: 'VERSION', dafaultValue: '',description: 'version to deploy on prod')
  choice(name: 'VERSION',choices: ['1.1.0','1.2.0','1.3.0'], description: 'Choice the verion for the build')
  booleanParam(name: 'executeTests', defaultValue: true, description: '')
}
environment {
  NEW_VERSION = '1.1.0' //Refencing environmental variable for your code
  SERVER_CREDENTIALS = credentials('server-credentials') //username and password referenced by ID = server-credentials
}
tools {
    maven 'maven3.8.6'
    //jdk
    //gradle
    }
    stages {
      stage('1. Build') { 
        when {
          expression{
            BRANCH_NAME == 'dev' && CODE_CHANGES == true //Build when there are code changes
            params.executeTests == true
        }
        steps{
          sh "mvn clean package"
          sh "echo 'Building version ${NEW_VERSION}"
         }
       }
      stage('2. Testing') { 
        when {
          expression{
            BRANCH_NAME == 'dev'
            BRANCH_NAME == 'dev' || BRANCH_NAME == 'master' //If it's dev or master branch
          }
        }
        steps{
          script {
            def var =
          }
          sh "echo 'Testing Code'"
          withCredentials([
              usernamePassword(credentilas: 'server-credentials', usernameVariable: USER, passwordVariable: PWD)
          ])
          sh "some script ${USER} ${PWD}"
         }
       }
      stage('3. Deploy') {
         steps{
          scripts{
            gv = load "script.groovy"
          }
          sh "deploy using ${SERVER_CREDENTIALS}"
          sh "docker stop fusisoft-webapps;docker rm fusisoft-webapps;docker rmi fusisoft-webapps:1.1.0;docker build -t fusisoft-webapps:1.1.0 .;docker run -itd --name=fusisoft-webapps -p 8085:8080 fusisoft-webapps:1.1.0"
         }
       }
      stage ('4. Email Notification') {
         steps{
         mail bcc: 'fusisoft@gmail.com', body: '''Build is Over
         Check the website URL for latest changes
         Thanks,
         Fusisoft Technology,
         +1 (313) 413-1477''', cc: 'fusisoft@gmail.com', from: '', replyTo: '', subject: 'Application was successfully deployed!!', to: 'fusisoft@gmail.com'
      }
    }
 }
}




