pipeline {
  agent { label 'java-build-node' }
  tools { maven 'maven3.9.6' }

  parameters {
    choice(name: 'BUILD_VERSION', choices: ['1.1.0', '1.2.0', '1.3.0'], description: 'Select version for build/deploy')
    booleanParam(name: 'EXECUTE_TESTS', defaultValue: true, description: 'Run unit tests?')
  }

  environment {
    NEW_VERSION = "${params.BUILD_VERSION}"
    SERVER_CREDS = credentials('server-credentials')   // exposes SERVER_CREDS_USR and SERVER_CREDS_PSW
  }

  tools {
    maven 'maven3.8.6'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build') {
      when { expression { return env.BRANCH_NAME == 'dev' } }
      steps {
        sh 'mvn -B clean package -DskipTests'
        sh 'echo "Building version: ${NEW_VERSION}"'
      }
    }

    stage('Test') {
      when {
        allOf {
          expression { return params.EXECUTE_TESTS == true }
          anyOf {
            expression { return env.BRANCH_NAME == 'dev' }
            expression { return env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master' }
          }
        }
      }
      steps {
        sh 'echo "Running tests..."'
        sh 'mvn -B test'

        withCredentials([usernamePassword(credentialsId: 'server-credentials', usernameVariable: 'USER', passwordVariable: 'PWD')]) {
          sh 'echo "Credentials loaded (USER=$USER). Do NOT print passwords."'
          // sh "some-script --user $USER --pass $PWD"
        }
      }
    }

    stage('Deploy') {
      when { expression { return env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master' } }
      steps {
        sh '''
          set -e
          echo "Deploying version ${NEW_VERSION}..."

          docker stop fusisoft-webapps || true
          docker rm fusisoft-webapps || true

          docker rmi fusisoft-webapps:${NEW_VERSION} || true
          docker build -t fusisoft-webapps:${NEW_VERSION} .

          docker run -d --name fusisoft-webapps -p 8085:8080 fusisoft-webapps:${NEW_VERSION}
          echo "Deployment complete ✅"
        '''
      }
    }
  }

  post {
    success { echo '✅ Pipeline successful' }
    failure { echo '❌ Pipeline failed' }
    cleanup { cleanWs() }
  }
}



