pipeline {
  agent {labels 'python-build-node'}

  tools {
    maven 'maven3.9.6'
  }

  environment {
    IMAGE_REPO    = "ndiforfusi/fusisoft-webapp"
    NOTIFY_EMAIL  = "fusisoft@gmail.com"
    DOCKER_CREDS  = "dockerhub-ndiforfusi"   // <-- Jenkins credentials ID
  }

  parameters {
    booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run tests?')
    booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Run container on this agent?')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      steps {
        sh 'mvn -B clean package -DskipTests'
      }
    }

    stage('Test (optional)') {
      when { expression { return params.RUN_TESTS } }
      steps {
        sh 'mvn -B test'
      }
    }

    stage('Docker Login') {
      steps {
        withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS}", usernameVariable: 'DH_USER', passwordVariable: 'DH_TOKEN')]) {
          sh 'echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin'
        }
      }
    }

    stage('Docker Build & Push') {
      steps {
        sh '''
          set -euo pipefail
          TAG="${BUILD_NUMBER}"
          docker build -t ${IMAGE_REPO}:${TAG} -t ${IMAGE_REPO}:latest .
          docker push ${IMAGE_REPO}:${TAG}
          docker push ${IMAGE_REPO}:latest
        '''
      }
    }

    stage('Deploy (optional)') {
      when { expression { return params.DEPLOY } }
      steps {
        sh '''
          set -euo pipefail
          TAG="${BUILD_NUMBER}"

          docker stop fusisoft-webapp 2>/dev/null || true
          docker rm fusisoft-webapp 2>/dev/null || true

          docker pull ${IMAGE_REPO}:${TAG}
          docker run -d --restart unless-stopped --name fusisoft-webapp -p 8085:8080 ${IMAGE_REPO}:${TAG}

          docker ps --filter "name=fusisoft-webapp"
        '''
      }
    }
  }

  post {
    success {
      emailext(
        to: "${env.NOTIFY_EMAIL}",
        subject: "✅ Jenkins SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Status:</b> SUCCESS ✅</p>
          <p><b>Job:</b> ${env.JOB_NAME}</p>
          <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
          <p><b>Build URL:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
          <p><b>Docker Image:</b> ${env.IMAGE_REPO}:${env.BUILD_NUMBER} (and :latest)</p>
        """
      )
    }

    failure {
      emailext(
        to: "${env.NOTIFY_EMAIL}",
        subject: "❌ Jenkins FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Status:</b> FAILED ❌</p>
          <p><b>Job:</b> ${env.JOB_NAME}</p>
          <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
          <p><b>Build URL:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
          <p><b>Console:</b> <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a></p>
          <p>Open the console output and search for <b>ERROR</b>.</p>
        """
      )
    }

    always {
      sh 'docker logout >/dev/null 2>&1 || true'
      cleanWs()
    }
  }
}




